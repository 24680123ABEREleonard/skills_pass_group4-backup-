# Gmail: enable 2-Step Verification and create an App Password for this application.
# Use that 16-character App Password below, not your normal Google account password.
# Copy this file to .env and replace the example account with your Gmail address.
# Keep .env private; it is ignored by Git and blocked from direct web requests.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD="your-16-character-google-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME=SkillPass
